{
  "name": "wardby-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "export": "expo export --platform all --output-dir dist",
    "api:sync": "node src/api/sync-contract.cjs",
    "api:generate": "node src/api/generate-schema.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.56.0",
    "marked": "^18.1.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.ts?(x)"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(@gluestack-ui|@react-aria|@react-stately|nativewind|react-native-css-interop|lucide-react-native|marked|.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "transform": {
          "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest"
        },
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.css.js"
        }
      },
      {
        "displayName": "api",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/api/__tests__/**/*.test.[jt]s"
        ],
        "transform": {
          "^.+\\.[jt]s$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        }
      }
    ],
    "testTimeout": 15000
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
